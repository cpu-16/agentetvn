# AgenteTVN · copia a .env (nunca se versiona .env)
DATABASE_URL=file:../db/agentetvn.db
# offline (por defecto): cero llamadas de red. online: habilita el LLM de redacción (extra).
AGENTETVN_MODO=offline
# Solo en modo online: endpoint compatible con OpenAI (/chat/completions). En el CT 130 es el shim local de Claude (claude -p).
LLM_BASE_URL=
LLM_MODEL=claude-opus-5-5
LLM_TIMEOUT_MS=60000
LLM_MAX_SIMULTANEAS=2
# Solo si el endpoint pide clave (el shim local no). Nunca en Notion ni en capturas.
LLM_API_KEY=
# Sincronización con Notion (opcional; si falta, se carga a mano desde docs/notion/)
NOTION_TOKEN=
NOTION_ROOT_PAGE=
# Caché local del modelo de embeddings (transformers.js)
HF_HUB_OFFLINE=1
# PIN de entrada a la mesa (demo). Cambiarlo en producción.
AGENTETVN_PIN=tvn2026
# Jarvis-TVN (voz). on/off; solo funciona con AGENTETVN_MODO=online. VOZ_TOKEN: secreto interno entre Next y el puente
# de voz (≥ 16 caracteres; el puente corre en otro CT y llega por internet con este token).
AGENTETVN_VOZ=off
VOZ_TOKEN=

# Optional server-only observability. Offline mode always disables it.
# Enable only after project/data-transfer approval and user-only secret entry.
AGENTETVN_TRACING=off
AGENTETVN_TRACE_APPROVED=0
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=AgenteTVN
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
# Exact deployed commit; absent means unknown (never infer main).
AGENTETVN_COMMIT=
